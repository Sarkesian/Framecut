{
  "name": "framecut-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A simple, local, single-user video editor",
  "author": "FrameCut",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "dev": "node desktop/server.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "npm run build && node tests/ui-journey.cjs && node tests/studio-journey.cjs && node tests/qol-journey.cjs && node tests/fixes-journey.cjs && node tests/undo-journey.cjs && node tests/audit-journey.cjs && node tests/sync-journey.cjs && node tests/backlog-journey.cjs && node tests/edit-stress-journey.cjs 200 1",
    "package": "npm run build && node scripts/fetch-python.cjs && electron-builder --win nsis --x64 && node scripts/publish-dist.cjs",
    "build:native": "node scripts/build-native.cjs",
    "build:icons": "electron scripts/build-icons.cjs",
    "test:native": "npm run build && node tests/native-journey.cjs",
    "test:captions": "npm run build && node tests/captions-journey.cjs",
    "fetch:python": "node scripts/fetch-python.cjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lottie-web": "^5.13.0",
    "lucide-preact": "^1.70.0",
    "multer": "^2.0.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@preact/preset-vite": "^2.10.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.1",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "local.framecut.studio",
    "productName": "FrameCut Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "shared/**/*",
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "desktop/icon.png",
      "!node_modules/ffprobe-static/bin/{darwin,linux}/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "desktop/bin/**/*",
      "desktop/speech/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "build/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FrameCutStudio-Setup.exe",
      "shortcutName": "FrameCut Studio",
      "uninstallDisplayName": "FrameCut Studio",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
